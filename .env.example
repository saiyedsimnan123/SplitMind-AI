# Gemini is optional. When unset, the agent uses labeled deterministic calculations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# PayPal Sandbox (server-side credentials only; never expose these in client code).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
APP_URL=

# Supabase service role is server-only. Apply supabase/schema.sql before using payments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
