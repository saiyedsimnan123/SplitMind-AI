# Gemini is optional. When unset, the agent uses labeled deterministic calculations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# PayPal Sandbox (server-side credentials only; never expose these in client code).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
APP_URL=http://localhost:3000

# Supabase Auth + Database + RLS (apply supabase/migrations/0001, 0002, and 0003 in order).
# Note: SUPABASE_SERVICE_ROLE_KEY is strictly server-only; NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
